# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
# Copie este arquivo para .env.local e reinicie: npm run dev
# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"
# Obrigatório no servidor para POST /api/projects (localhost e Vercel)
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# Resend API configuration for email
RESEND_API_KEY="re_..."
RESEND_FROM="SV LOTES <noreply@svlotes.com.br>"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Links públicos enviados a clientes (assinatura, validação) — sempre produção
NEXT_PUBLIC_PUBLIC_APP_URL="https://www.svlotes.com.br"

# Cron secret (Vercel Cron + /api/cron/*)
CRON_SECRET="your-cron-secret"

# Z-API — WhatsApp automático (Automações SaaS + Portal do Cliente OTP)
# Preview e Production precisam dos três (INSTANCE_ID, INSTANCE_TOKEN, CLIENT_TOKEN opcional)
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
# Token de segurança da conta (header Client-Token) — painel Z-API → Segurança
ZAPI_CLIENT_TOKEN=
# Alias legado aceito no lugar de ZAPI_INSTANCE_TOKEN
# ZAPI_TOKEN=

# Demonstração pública (/demo) — senha exibida na página de acesso demo
DEMO_USER_PASSWORD="defina-uma-senha-segura"

# Portal do Cliente (develop/preview) — somente leitura, desativado por padrão
CLIENT_PORTAL_ENABLED=false
NEXT_PUBLIC_CLIENT_PORTAL_ENABLED=false
# Segredos do portal (OTP/sessão/link) — definir em preview/produção quando ativar
CLIENT_PORTAL_SESSION_SECRET="defina-um-segredo-forte"
CLIENT_PORTAL_LINK_SECRET="defina-um-segredo-forte"

# Módulo Bancário SV LOTES 2.0 (develop/preview) — desativado por padrão
BANKING_MODULE_ENABLED=false
# UI Configurações — manter igual ao valor acima
NEXT_PUBLIC_BANKING_MODULE_ENABLED=false
# Criptografia de credenciais bancárias (client secret, webhook secret, senha certificado)
BANKING_CREDENTIALS_ENCRYPTION_KEY="defina-uma-chave-segura-min-16-chars"
